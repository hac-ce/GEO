# Copy to .env.docker; demo never calls the real model.
GEO_MODE=demo
GEO_HTTP_PORT=8085
GEO_WORKER_COUNT=2
GEO_WORKER_SHUTDOWN_TIMEOUT=10
GEO_JOB_LEASE_SECONDS=60
GEO_JOB_HEARTBEAT_SECONDS=15
GEO_JOB_RECOVERY_SECONDS=15
GEO_REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
GEO_REDIS_TTL=60
GEO_RATE_WINDOW_SECONDS=60
GEO_LOGIN_RATE_LIMIT=10
GEO_REGISTER_RATE_LIMIT=5
GEO_COLLECTION_RATE_LIMIT=10
DEEPSEEK_API_KEY=
GEO_BROWSER_ENABLED=false
GEO_BROWSER_TIMEOUT=120
